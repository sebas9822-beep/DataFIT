# Copia este archivo como ".env" (misma carpeta) y llena lo que tengas. Nada aquí es obligatorio:
# sin llaves, la aplicación trabaja con el catastro, las capas de la Alcaldía y OpenStreetMap,
# y la curaduría usa Claude Code con la sesión del plan Claude de este equipo.
# El archivo .env no se sube a git.

# --- Google Maps Platform (opcional) ---------------------------------------------------------
# Llave de SERVIDOR: Places API (New) y Geocoding API. Restringir por API y por IP.
# Nunca llega al navegador.
GOOGLE_SERVER_KEY=

# Llave de NAVEGADOR: Maps JavaScript API y Places API (New), para el mapa y el autocompletado.
# Restringir por referente HTTP a  http://127.0.0.1:8765/*  y  http://localhost:8765/*
GOOGLE_BROWSER_KEY=

# Identificador del mapa (Map ID) para los marcadores avanzados. Sin valor se usa DEMO_MAP_ID.
GOOGLE_MAP_ID=

# --- Claude (opcional) -----------------------------------------------------------------------
# Solo si prefieres la API de Anthropic en vez de Claude Code. Requiere:  pip install anthropic
ANTHROPIC_API_KEY=

# --- Identificación ante servicios públicos ---------------------------------------------------
# Correo de contacto que viaja en el User-Agent hacia OpenStreetMap (lo piden sus condiciones).
CONTACTO=
